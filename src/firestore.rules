
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isWorkspaceOwner(workspaceId) {
        return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerIds;
    }

    function isWorkspaceMember(workspaceId) {
        return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;
    }
    
    function isTeamOwner(teamId) {
        return isSignedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    function isTeamMember(teamId) {
        return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }
    
    function isInSharedTeam(userId) {
      return isSignedIn() && exists(/databases/$(database)/documents/teams/{teamId}) &&
             get(/databases/$(database)/documents/teams/{teamId}).data.memberIds.hasAll([request.auth.uid, userId]);
    }

    match /mail/{docId} {
      allow create: if isSignedIn();
      allow read, delete: if true;
    }

    match /batch-write/{docId} {
      allow create: if request.auth != null; 
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    match /invites/{inviteId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
      allow get: if isOwner(userId) || isInSharedTeam(userId);
      allow list: if isSignedIn();
    }
    
    match /users/{userId}/chats/{chatId} {
        allow read, write, create, delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write, create, delete: if isOwner(userId);
        }
    }
    
    match /users/{userId}/{collectionId}/{docId} {
        allow read, write, create, delete: if isOwner(userId);
    }

    match /teams/{teamId} {
        allow get: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
        
        allow update: if isSignedIn() && (
            isTeamOwner(teamId) ||
            request.auth.uid in request.resource.data.memberIds
        );
        
        allow delete: if isTeamOwner(teamId);
        allow list: if isSignedIn();

        match /usage/{usageId} {
          allow read: if isTeamMember(teamId);
          allow write: if false; // Only server can write via Admin SDK
          allow create: if false; // Only server
        }
    }

    match /workspaces/{workspaceId} {
      allow get: if isSignedIn();
      
      allow create: if isSignedIn() && isTeamMember(request.resource.data.teamId);
      
      allow update: if isSignedIn() && (
          isWorkspaceOwner(workspaceId) ||
          request.auth.uid in request.resource.data.memberIds
      );
      
      allow delete: if isWorkspaceOwner(workspaceId);
      allow list: if isSignedIn();

      match /{document=**} {
        allow read, write: if isWorkspaceMember(workspaceId) || isWorkspaceOwner(workspaceId);
      }
      
      match /accessRules/{userId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isTeamMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.teamId) && request.auth.uid == userId;
        allow update, delete: if isWorkspaceOwner(workspaceId);
      }
    }
  }
}
